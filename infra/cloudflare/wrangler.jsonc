{
  // Web de PlatLab y su puerta a la API (ADR 0033). Los archivos de la web se sirven como activos; el Worker solo
  // atiende /v1/* y lo reenvía a la API. Se despliega desde el CI (.github/workflows/deploy.yml).
  "$schema": "https://unpkg.com/wrangler@4/config-schema.json",
  "name": "platlab",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-13",
  "assets": {
    "directory": "../../apps/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/v1/*"]
  },
  "vars": {
    // La URL pública del servicio en Render (infra/README.md).
    "API_ORIGIN": "https://platlab-api.onrender.com"
  }
  // El corte del dominio se agrega al final (infra/README.md): "routes": [{ "pattern": "platlab.ohmroyal.org", "custom_domain": true }]
}
