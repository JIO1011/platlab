{
  "name": "@platlab/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/entrypoints/api.ts",
    "start": "tsx src/entrypoints/api.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --exclude '**/*.int.test.ts'",
    "test:int": "vitest run --dir src '.int.test.ts'",
    "db:types": "pgtyped -c pgtyped.config.json"
  },
  "dependencies": {
    "@pgtyped/runtime": "2.4.2",
    "@platlab/contracts": "workspace:*",
    "@platlab/modules": "workspace:*",
    "fastify": "5.12.5",
    "jose": "6.2.12",
    "pg": "8.23.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@pgtyped/cli": "2.4.3",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15"
  }
}
